# --- 单体化后的 SQLite 配置 ---
DATABASE_PATH=./data/kirameku.db
SITE_READ_ONLY=0
BACKUP_DIR=./backups

# --- 认证 ---
# 至少 32 字符：openssl rand -base64 48
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
FRONTEND_ORIGIN=http://localhost:3000

# --- 一次性管理员 seed（命令行传入；不要提交真实密码） ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=站长

# --- 图片上传 ---
# 配置完整的 OSS_* 后写入阿里云 OSS；未配置时写入 UPLOAD_DIR（默认 ./uploads）。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=Boke/
UPLOAD_DIR=./uploads

# --- 隐私 ---
# 访客记录（含 IP）保留天数；每日 cron 运行 pnpm db:prune-visitors
VISITOR_RETENTION_DAYS=90
