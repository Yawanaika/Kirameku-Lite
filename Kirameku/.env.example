# --- 单体化后的 SQLite 配置 ---
DATABASE_PATH=./data/kirameku.db
SITE_READ_ONLY=0
BACKUP_DIR=./backups

# --- 站点 / 分享 ---
# 站点对外 URL：sitemap、RSS、canonical、Open Graph 全部用它拼绝对地址。
# 未设置时回退到 FRONTEND_ORIGIN，再回退到 siteConfig.url。
# SITE_URL=https://boke.hiromu.top
# 全站分享卡片（Open Graph / Twitter）；标题与描述默认取 siteConfig.ts。
# SITE_SHARE_TITLE=
# SITE_SHARE_DESCRIPTION=
# SITE_SHARE_IMAGE=/images/hong.jpg
# SITE_SHARE_CARD=summary_large_image
# RSS 里的作者邮箱，留空则只输出站点作者名。
# SITE_CONTACT_EMAIL=

# --- 认证 ---
# 至少 32 字符：openssl rand -base64 48
AUTH_SECRET=
# 可选：保护 /api/internal/metrics 等维护接口；未设置时这些接口返回 404
CRON_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback
FRONTEND_ORIGIN=http://localhost:3000

# --- 预警通知（后台 /admin/notifications） ---
# 后台定时巡检：未设置时默认开启，设 0/false 关闭（关闭后只能手动推送）。
NOTIFICATION_CHECKS=1
# 巡检间隔，单位分钟，取值 1-1440，默认 5。
NOTIFICATION_INTERVAL_MINUTES=5

# --- 一次性管理员 seed（命令行传入；不要提交真实密码） ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=站长

# --- 图片上传 ---
# 配置完整的 OSS_* 后写入阿里云 OSS；未配置时写入 UPLOAD_DIR（默认 ./uploads）。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=Boke/
UPLOAD_DIR=./uploads

# --- 隐私 / 维护 ---
# 访客记录（含 IP）保留天数；scripts/maintenance.sh 每日运行 db:prune-visitors
VISITOR_RETENTION_DAYS=90
# 备份目录（db 快照 + uploads 归档 + meta）；脚本走这里的 BACKUP_DIR，
# 容器内被 compose 固定为 /data/backups
# BACKUP_DIR=./backups
