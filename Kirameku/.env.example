# Kirameku-Lite 环境变量模板（裸机 / 本地开发）
#
#   cp .env.example .env.local      # 应用与 db:* 脚本读取这个文件
#
# Docker Compose 部署使用仓库根目录的 `.env`（模板：compose.env.example）。
# 两份文件的变量名、顺序与默认值保持一致；只被 Compose / 运维脚本读取的变量
# 列在文末，填在那边。

# --- 数据库与本地路径 ---
# SQLite 文件路径。注意 db:* 脚本不加载 .env.local：用非默认路径时在命令前显式传。
DATABASE_PATH=./data/kirameku.db
# 未配置 OSS 时的本地上传目录（容器内固定为 /data/uploads）。
UPLOAD_DIR=./uploads
# db:backup 的快照目录；维护脚本与保留策略都读它（容器内固定为 /data/backups）。
BACKUP_DIR=./backups

# --- 站点与分享 ---
# 同源校验与 GitHub OAuth 回调使用；本地默认 http://localhost:3000。
FRONTEND_ORIGIN=http://localhost:3000
# 站点对外 URL：sitemap、RSS、canonical、Open Graph 全部用它拼绝对地址。
# 未设置时回退到 FRONTEND_ORIGIN，再回退到 siteConfig.url。
# SITE_URL=https://boke.hiromu.top
# 全站分享卡片（Open Graph / Twitter）；标题与描述默认取 siteConfig.ts。
# SITE_SHARE_TITLE=
# SITE_SHARE_DESCRIPTION=
# SITE_SHARE_IMAGE=/images/hong.jpg
# SITE_SHARE_CARD=summary_large_image
# RSS 里的作者邮箱，留空则只输出站点作者名。
# SITE_CONTACT_EMAIL=

# --- 认证与内部接口 ---
# 至少 32 字符：openssl rand -base64 48
AUTH_SECRET=
# 可选：保护 /api/internal/metrics 与 /api/internal/notify 等维护接口；
# 未设置时这些接口一律返回 404。不要与 AUTH_SECRET 用同一个值。
CRON_SECRET=
# 可选 GitHub OAuth（访客评论 / 点赞）；回调地址必须与 OAuth App 里登记的一致。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# --- 预警通知（后台 /admin/notifications） ---
# 后台定时巡检：未设置时默认开启，设 0/false 关闭（关闭后只能手动推送）。
NOTIFICATION_CHECKS=1
# 巡检间隔，单位分钟，取值 1-1440，默认 5。
NOTIFICATION_INTERVAL_MINUTES=5

# --- 图片上传（阿里云 OSS） ---
# 四个必填项（ACCESS_KEY_ID / ACCESS_KEY_SECRET / BUCKET_NAME / ENDPOINT）都填了
# 才会写入 OSS，否则图片落在 UPLOAD_DIR。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_CUSTOM_DOMAIN=https://cdn.example.com
# OSS_PREFIX=Boke/

# --- 隐私与维护 ---
# 1 = 拒绝公开写接口（迁移 / 维护窗口用）。
SITE_READ_ONLY=0
# 访客记录（含 IP）保留天数；scripts/maintenance.sh 每日跑 db:prune-visitors。
VISITOR_RETENTION_DAYS=90

# --- 一次性管理员 seed（命令行参数，不写进 .env.local） ---
#   ADMIN_USERNAME=admin ADMIN_PASSWORD='至少12位的密码' pnpm db:seed-admin
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_NICKNAME=站长

# --- 只被 Compose / 运维脚本读取（填在 compose.env.example → 仓库根目录 .env） ---
# SHARED_NETWORK / SITE_DOMAIN / KIRAMEKU_IMAGE / KIRAMEKU_DATA_DIR / KIRAMEKU_BACKUP_DIR
# KIRAMEKU_LOG_MAX_SIZE / KIRAMEKU_LOG_MAX_FILE
# MAINTENANCE_TIMER / MAINTENANCE_SCHEDULE
# PROBE_TIMER / PROBE_SCHEDULE / PROBE_FAIL_THRESHOLD
# PULL_GIT / BACKUP_BEFORE_DEPLOY / PRUNE_IMAGES / HEALTH_TIMEOUT / APP_UID
