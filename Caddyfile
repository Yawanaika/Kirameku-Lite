# Caddyfile for the *bundled* Caddy, used only when this stack runs its own
# proxy:
#
#   docker compose -f docker-compose.yml -f docker-compose.caddy.yml up -d
#
# If a Caddy already runs elsewhere (the common case), this file is unused —
# that proxy joins the `kirameku-edge` network and proxies to
# `kirameku-app:3000` from its own config. See DEPLOY_NOTES.md section 3.
#
# Lets Caddy obtain and renew certificates for SITE_DOMAIN automatically.
# Certificates and ACME account material are stored in the `caddy-data` volume,
# so they survive container re-creation.

# Optional ACME account email. Uncomment and set ACME_EMAIL in .env to receive
# expiry warnings from Let's Encrypt; Caddy works without it.
# {
# 	email {$ACME_EMAIL}
# }

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploads are capped at 10MB by the app; allow a little headroom.
	request_body {
		max_size 12MB
	}

	# No cache-header rewrites here on purpose: Next.js already answers
	# /_next/static/* with "public, max-age=31536000, immutable" and sends its
	# own Cache-Control for HTML and /uploads/*. Setting the header again in
	# Caddy would emit a duplicate Cache-Control on every asset.

	reverse_proxy kirameku-app:3000
}
