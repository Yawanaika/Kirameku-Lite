# Docker Compose environment template.
#
#   cp compose.env.example .env
#
# docker compose reads the repository-root .env for variable substitution.
# DATABASE_PATH / UPLOAD_DIR / BACKUP_DIR are set by docker-compose.yml and do
# not need to be repeated here.

# Required. At least 32 characters: openssl rand -base64 48
AUTH_SECRET=

# Network your reverse proxy and this app share. The app is reachable on it as
# kirameku-app:3000. Point your Caddy at that instead of 127.0.0.1 — a proxy
# running as a container in another compose project cannot reach the host's
# loopback. The deploy script creates the network if it is missing.
SHARED_NETWORK=kirameku-edge

# Only needed when this stack also runs Caddy (docker-compose.caddy.yml):
# the public hostname Caddy obtains a certificate for. Leave blank if you
# already run your own proxy. Must match FRONTEND_ORIGIN below (no scheme).
# SITE_DOMAIN=boke.hiromu.top

# Public origin used for same-origin checks and GitHub OAuth redirects.
FRONTEND_ORIGIN=https://boke.hiromu.top

# Optional. Canonical public URL used for absolute links: sitemap, RSS, canonical
# tags and Open Graph/Twitter card URLs. Falls back to FRONTEND_ORIGIN, then to
# the build-time siteConfig.url. Set it when the public domain differs from the
# origin the app sees behind the proxy.
# SITE_URL=https://boke.hiromu.top

# Optional. Share-card (Open Graph / Twitter) overrides for the whole site.
# Titles/descriptions default to siteConfig.ts; SITE_SHARE_IMAGE may be a path
# on this site (/images/x.jpg) or an absolute URL.
# SITE_SHARE_TITLE=
# SITE_SHARE_DESCRIPTION=
# SITE_SHARE_IMAGE=/images/hong.jpg
# SITE_SHARE_CARD=summary_large_image

# Optional. Contact address in the RSS feed's author field.
# SITE_CONTACT_EMAIL=

# Optional. Docker log rotation for the app container: json-file driver with a
# per-file size cap and a file count. Without this, logs grow unbounded on the
# host. Read them with: docker compose logs --tail 200 app
# KIRAMEKU_LOG_MAX_SIZE=100m
# KIRAMEKU_LOG_MAX_FILE=3

# Optional. Protects /api/internal/metrics; when unset the endpoint returns 404.
# Use a different value from AUTH_SECRET.
CRON_SECRET=

# Optional. Pins the deployed image; defaults to ghcr.io/<owner>/kirameku-lite:latest
# as written in docker-compose.yml. scripts/deploy-server.sh overrides this for
# rollbacks, so leave it unset unless you want to freeze a specific tag.
# KIRAMEKU_IMAGE=ghcr.io/yawanaika/kirameku-lite:latest

# Optional GitHub OAuth (visitor comments / likes).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Optional Alibaba Cloud OSS. Leave blank to store uploads in the
# kirameku-data volume instead (/data/uploads).
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=

# Optional. Where the SQLite database + uploads (KIRAMEKU_DATA_DIR) and the
# backups (KIRAMEKU_BACKUP_DIR) live on the host. Defaults are ./data and
# ./backup next to this file. Both are bind-mounted into the container's /data,
# so the directories must exist and be writable by UID 1000 before the first
# start — scripts/deploy-server.sh does that for you, and for a manual start:
#   mkdir -p data/db data/uploads backup && sudo chown -R 1000:1000 data backup
# KIRAMEKU_DATA_DIR=./data
# KIRAMEKU_BACKUP_DIR=./backup

# Optional maintenance switch (1 = reject public writes) and visitor IP
# retention in days.
SITE_READ_ONLY=0
VISITOR_RETENTION_DAYS=90

# Optional. scripts/deploy-server.sh installs (and refreshes) a systemd timer
# that runs scripts/maintenance.sh once a day: backup + uploads archive, visitor
# pruning, counter reconciliation. It needs passwordless sudo on the server; when
# that is unavailable the deploy logs a WARNING and continues.
# MAINTENANCE_TIMER=1
# MAINTENANCE_SCHEDULE=*-*-* 04:30:00
