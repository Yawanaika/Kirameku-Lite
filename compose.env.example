# Kirameku-Lite 环境变量模板（Docker Compose 部署）
#
#   cp compose.env.example .env
#
# docker compose 读取仓库根目录的 `.env` 做变量替换。DATABASE_PATH / UPLOAD_DIR /
# BACKUP_DIR 由 docker-compose.yml 固定为 /data 下的路径，不需要在这里重复。
# 裸机 / 本地开发请用 Kirameku/.env.example 生成 .env.local：两份文件的变量名、
# 顺序与默认值保持一致。

# --- 应用必需 ---
# 管理员 JWT 签名密钥，至少 32 字符：openssl rand -base64 48
AUTH_SECRET=
# 同源校验与 GitHub OAuth 回调使用；填正式 HTTPS 域名（不带路径与斜杠）。
FRONTEND_ORIGIN=https://boke.hiromu.top

# --- 站点与分享 ---
# 可选。站点对外 URL：sitemap、RSS、canonical、Open Graph 全部用它拼绝对地址。
# 未设置时回退到 FRONTEND_ORIGIN，再回退到构建期的 siteConfig.url；
# 公网域名与进程看到 Origin 不一致时才需要显式设置。
# SITE_URL=https://boke.hiromu.top
# 可选。全站分享卡片（Open Graph / Twitter）；标题与描述默认取 siteConfig.ts，
# SITE_SHARE_IMAGE 可以是本站路径（/images/x.jpg）或绝对 URL。
# SITE_SHARE_TITLE=
# SITE_SHARE_DESCRIPTION=
# SITE_SHARE_IMAGE=/images/hong.jpg
# SITE_SHARE_CARD=summary_large_image
# 可选。RSS <author> 里的联系邮箱。
# SITE_CONTACT_EMAIL=

# --- 认证与内部接口 ---
# 可选：保护 /api/internal/metrics 与 /api/internal/notify；未设置时返回 404。
# 不要与 AUTH_SECRET 用同一个值。
CRON_SECRET=
# 可选 GitHub OAuth（访客评论 / 点赞）。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://boke.hiromu.top/api/auth/github/callback

# --- 预警通知（后台 /admin/notifications） ---
# 进程内定时巡检：1 = 开（未设置时的默认值），0 = 关；间隔单位分钟（1-1440）。
NOTIFICATION_CHECKS=1
NOTIFICATION_INTERVAL_MINUTES=5

# --- 图片上传（阿里云 OSS） ---
# 四个必填项（ACCESS_KEY_ID / ACCESS_KEY_SECRET / BUCKET_NAME / ENDPOINT）都填了
# 才会写入 OSS，否则图片落在容器内 /data/uploads（即宿主机 ./data/uploads）。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_CUSTOM_DOMAIN=https://cdn.example.com
# OSS_PREFIX=Boke/

# --- 隐私与维护 ---
SITE_READ_ONLY=0
VISITOR_RETENTION_DAYS=90

# --- 一次性管理员 seed（docker compose exec 的命令行参数，不进 .env） ---
#   docker compose exec app \
#     env ADMIN_USERNAME=admin ADMIN_PASSWORD='至少12位的密码' pnpm db:seed-admin

# --- 网络与反代 ---
# 反代与本项目共享的 Docker 网络；应用在其中以 kirameku-app:3000 暴露。
# 别的 compose 项目里的 Caddy 访问不到宿主机 127.0.0.1，要指向这个别名。
# 网络不存在时部署脚本会自动创建。
SHARED_NETWORK=kirameku-edge
# 仅当本项目自带 Caddy（docker-compose.caddy.yml）时需要：Caddy 申请证书用的
# 公网主机名，必须与上面的 FRONTEND_ORIGIN 一致（不带协议）。
# SITE_DOMAIN=boke.hiromu.top

# --- 镜像与宿主机路径 ---
# 可选。锁定部署的镜像标签；不设置时用 docker-compose.yml 里的默认值
# ghcr.io/<owner>/kirameku-lite:latest（回滚脚本会临时覆盖它）。
# KIRAMEKU_IMAGE=ghcr.io/yawanaika/kirameku-lite:latest
# 可选。SQLite + uploads 与备份在宿主机上的落点，默认是本文件旁边的 ./data 与
# ./backup；两者都 bind mount 进容器的 /data，因此目录必须存在且属主是 UID 1000
# （部署脚本每次发布会自动创建并 chown）。手动首次启动：
#   mkdir -p data/db data/uploads backup && sudo chown -R 1000:1000 data backup
# KIRAMEKU_DATA_DIR=./data
# KIRAMEKU_BACKUP_DIR=./backup
# 可选。app 容器日志轮转（json-file）：单文件上限与保留个数，不设置则无限增长。
# 查看：docker compose logs --tail 200 app
# KIRAMEKU_LOG_MAX_SIZE=100m
# KIRAMEKU_LOG_MAX_FILE=3

# --- 发布脚本（scripts/deploy-server.sh） ---
# 1 = 部署前先 git pull --ff-only，让新增脚本/覆盖文件一起到位；默认 0。
# 新增文件（例如 scripts/probe-health.sh）不会随镜像到达服务器工作树，
# 需要它时把这个开关打开。
# PULL_GIT=1
# 其余可选开关（默认值见脚本头部注释）：BACKUP_BEFORE_DEPLOY=1 / PRUNE_IMAGES=1
# HEALTH_TIMEOUT=180 / APP_UID=1000 / SERVICES / APP_SERVICE=app / COMPOSE_FILE

# --- 定时维护 ---
# scripts/deploy-server.sh 安装（并刷新）每日运行 scripts/maintenance.sh 的 systemd
# timer：备份 + uploads 归档、访客清理、计数校正。需要免密 sudo；没有时部署只打
# WARNING 并继续。时间用服务器本地时区（生产机是 UTC，19:30 = 北京 03:30）。
# MAINTENANCE_TIMER=1
# MAINTENANCE_SCHEDULE=*-*-* 04:30:00

# --- 同机健康探针（方案 B） ---
# 部署脚本还会装一个 systemd timer，每 5 分钟从宿主机请求公网 /api/health
# （scripts/probe-health.sh），连续 PROBE_FAIL_THRESHOLD 次失败后 POST
# /api/internal/notify。进程内自检看不见反代 502 或 Tunnel 断开，这个能看见；
# 但整机宕机时它也发不出去，所以要配 ops/cloudflare-probe/ 的站外探针（方案 A）。
# 投递需要 CRON_SECRET（没配时内部端点按 404 隐藏）。
# PROBE_TIMER=1
# PROBE_SCHEDULE=*-*-* *:0/5:00
# PROBE_FAIL_THRESHOLD=2
